// params
params {
  location = "irods"
  samplesheet = null
  fasta = null
  run_snps = false
  run_mutations = false
  refcds = null
  seq_type = "dna"
  dnahyb_bed = null
  vdj_bed = null
  ig_bed = null
  csr_max_norm_cov = 0.02
  light_chain_max_norm_cov = 0.02
  baf_chrs = null
  baf_genes = null
  min_bq = 30 
  min_mq = 30
  mask = 3844
  knit_qc_report = false
  knit_genotyping_report = false
  min_alt_vaf = 0.2
  min_alt_depth = 3
  out_dir = "out/"
  no_chr_prefix = false
  publish_dir_mode = "copy"
}

// modules
process {
  errorStrategy = { task.exitStatus in [9,104,130,134,137,138,139,140,143] ? 'retry' : 'ignore' }
  withName: 'MOSDEPTH' {
    container = "https://depot.galaxyproject.org/singularity/mosdepth:0.3.8--hd299d5a_0"
    queue = "normal"
    cpus = 8
    memory = { 20.GB * task.attempt }
    publishDir = [
      path: { "${params.out_dir}/${meta.donor_id}/cells/${meta.id}/mosdepth/" },
      mode: params.publish_dir_mode,
      pattern: "*.{global.dist.txt,summary.txt,region.dist.txt,regions.bed.gz,regions.bed.gz.csi}"
    ]
  }
  // the aliased runs also match the selector above, so they need their own
  // publishDir - otherwise all three write ${meta.id}.regions.bed.gz into the
  // same directory and overwrite each other
  withName: 'MOSDEPTH_VDJ' {
    publishDir = [
      path: { "${params.out_dir}/${meta.donor_id}/cells/${meta.id}/vdj/" },
      mode: params.publish_dir_mode,
      pattern: "*.{regions.bed.gz,regions.bed.gz.csi}"
    ]
  }
  withName: 'MOSDEPTH_IG' {
    ext.prefix = { "${meta.id}.ig" }
    publishDir = [
      path: { "${params.out_dir}/${meta.donor_id}/cells/${meta.id}/vdj/" },
      mode: params.publish_dir_mode,
      pattern: "*.{regions.bed.gz,regions.bed.gz.csi}"
    ]
  }
}

// environments
singularity.autoMounts = true
singularity.enabled = true
